# Template only. Do not put service-role or provider secrets in browser variables.
# These values are for local server/Edge Function development only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public-anon-key>
# SUPABASE_SERVICE_ROLE_KEY must be configured as a server/Edge Function secret,
# never in this file if the file is served to the browser.

# Optional Astro AI Edge Function secrets — configure ONLY in Supabase Edge Function secrets.
# Never expose these in frontend JavaScript, HTML, Vite variables, or a public .env file.
# AI_PROVIDER_API_KEY=<secret>
# AI_PROVIDER_URL=<approved OpenAI-compatible chat-completions endpoint>
# AI_MODEL=<approved model name>
# ASTRO_ALLOWED_ORIGINS=https://your-approved-domain.example
